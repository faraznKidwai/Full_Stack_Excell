datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id          Int      @id @default(autoincrement())
  ticker      String   @unique
  companyName String?
  status      Boolean? @default(true)
  sector      String?
  industry    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
